+# Dekopon's core on a PC, as a library for Pokemon Fulldex: the same core as the Switch build,
+# with an SDL2 + OpenGL window and input in place of citra_switch's libnx ones.
+add_library(citra_pc STATIC pc_frontend.cpp)
+target_link_libraries(citra_pc PUBLIC citra_core citra_common video_core audio_core input_common glad fmt)
+target_include_directories(citra_pc PRIVATE ${CMAKE_SOURCE_DIR}/src)
+find_package(SDL2 REQUIRED)
+target_link_libraries(citra_pc PRIVATE SDL2::SDL2)
+
+# A stand-in program: it prints the exact link line for Pokemon Fulldex to repeat, and plays a ROM
+# given on the command line (the same code Fulldex calls) for a test without the game list.
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/probe.cpp" "int DekoponPcPlay(const char*, const char*);\nint main(int c, char** v) { return c < 2 ? 1 : DekoponPcPlay(v[1], c > 2 ? v[2] : \"./dekopon/\"); }\n")
+add_executable(citra_pc_probe "${CMAKE_CURRENT_BINARY_DIR}/probe.cpp")
+target_link_libraries(citra_pc_probe PRIVATE citra_pc)
