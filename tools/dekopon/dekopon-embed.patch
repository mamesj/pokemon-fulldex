 }
 
+#ifdef DEKOPON_EMBEDDED
+// (The host program owns libnx's handler and calls HorizonExceptionDispatch from it.)
+extern "C" void DekoponCrashHandler(ThreadExceptionDump* ctx) {
+#else
 extern "C" void __libnx_exception_handler(ThreadExceptionDump* ctx) {
+#endif
     BuildReport(ctx);
     WriteReportToSd();
     write(STDERR_FILENO, s_report, s_report_len);
